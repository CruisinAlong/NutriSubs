<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriSubs.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <!-- Branding -->
            <Label
                Text="NutriSubs"
                FontSize="34"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Eat well. Spend well."
                FontSize="16"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                HorizontalOptions="Center" />

            <!-- Import Recipe -->
            <Frame
                Padding="16"
                CornerRadius="12"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Import a Recipe" FontAttributes="Bold" FontSize="18" />
                    <Entry
                        x:Name="RecipeUrlEntry"
                        Placeholder="Paste a recipe URL here" />
                    <Button
                        x:Name="ImportRecipeButton"
                        Text="Import Recipe"
                        Clicked="OnImportRecipeClicked"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Frame>

            <!-- Sample Recipes -->
            <Label
                Text="Browse Sample Recipes"
                FontAttributes="Bold"
                FontSize="18" />

            <CollectionView x:Name="RecipesCollectionView" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="14"
                            Margin="0,0,0,10"
                            CornerRadius="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                            BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Description}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Label Text="{Binding PrepTimeDisplay}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                                <Button
                                    Text="View Recipe"
                                    HorizontalOptions="Start"
                                    Clicked="OnViewRecipeClicked"
                                    CommandParameter="{Binding Id}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Simple nav area -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Home" Clicked="OnHomeClicked" />
                <Button Text="Recipes" Clicked="OnRecipesClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
